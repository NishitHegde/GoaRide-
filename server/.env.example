# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/goaride

# JWT Secret Key
JWT_SECRET=goaride_jwt_secret_key_2026_super_secure

# Frontend Application URL (used for generating verification links)
CLIENT_URL=http://localhost:5173

# Real Email Delivery Configuration (Nodemailer SMTP)
# For Gmail: Use smtp.gmail.com, port 587, and a Google App Password (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
EMAIL_FROM="GoaRide Rentals" <no-reply@goaride.com>

# Initial System Admin Setup (Optional)
ADMIN_EMAIL=admin@goaride.com
ADMIN_PASSWORD=admin123
