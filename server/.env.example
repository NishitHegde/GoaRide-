PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/goaride
JWT_SECRET=goaride_jwt_secret_key_2026_super_secure
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# OPTION A: Resend API (Recommended - Sign up free at https://resend.com)
RESEND_API_KEY=

# OPTION B: Brevo API (Sign up free at https://brevo.com)
BREVO_API_KEY=

# OPTION C: Nodemailer SMTP (Gmail / Outlook / Amazon SES / SendGrid SMTP)
# For Gmail: Use 2-Step Verification + 16-character App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GoaRide Verification" <no-reply@goaride.com>

# Initial System Admin Setup (UNTOUCHED)
ADMIN_EMAIL=admin@goaride.com
ADMIN_PASSWORD=admin123
