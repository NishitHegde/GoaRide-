PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/goaride
JWT_SECRET=goaride_jwt_secret_key_2026_super_secure
CLIENT_URL=http://localhost:5173

# OPTION A: Resend API (Recommended - Instant real inbox delivery)
# Sign up free at https://resend.com and paste your API key below:
RESEND_API_KEY=

# OPTION B: Gmail / Outlook SMTP Configuration
# For Gmail: Use 2-Step Verification + 16-character App Password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="GoaRide Verification" <no-reply@goaride.com>

# Initial System Admin Setup
ADMIN_EMAIL=admin@goaride.com
ADMIN_PASSWORD=admin123
